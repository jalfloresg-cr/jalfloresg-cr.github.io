---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { Icon } from 'astro-icon/components';
---

<header>
	<nav>
		<h2>
			<a href="/">{SITE_TITLE}</a>
		</h2>

		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>

		<div class="social-links">
			<a
				href="https://cr.linkedin.com/in/jose-flores-garcia-5741158b"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="José Flores on LinkedIn"
				title="LinkedIn"
			>
				<Icon
					name="simple-icons:linkedin"
					width="26"
					height="26"
				/>
			</a>

			<a
				href="https://github.com/jalfloresg-cr"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="José Flores on GitHub"
				title="GitHub"
			>
				<Icon
					name="simple-icons:github"
					width="27"
					height="27"
				/>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1.5rem;

		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;

		max-width: 1280px;
		margin: 0 auto;
	}

	h2 {
		margin: 0;
		font-size: 1rem;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}

	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}

	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}

	.internal-links {
		display: flex;
		align-items: center;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;

		padding: 0.5rem;

		border-bottom: none;

		transition:
			color 0.2s ease,
			transform 0.2s ease;
	}

	.social-links a:hover {
		color: var(--accent);
		transform: translateY(-2px);
	}

	@media (max-width: 720px) {
		header {
			padding: 0 1rem;
		}

		.social-links {
			display: none;
		}
	}
</style>